# ==========================================
# EduAidel — Environment Variables Template
# ==========================================

# Supabase Public Configuration (Client & Server)
# Found in: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Admin / Service Role Key (SERVER-ONLY - Never expose to client!)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# PostgreSQL Connection String for Drizzle ORM
# Direct or connection pooled connection URL (port 5432 or 6543)
# Found in: Supabase Dashboard -> Project Settings -> Database -> Connection string
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
